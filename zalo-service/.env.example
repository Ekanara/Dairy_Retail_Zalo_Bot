# ── Zalo OA credentials ───────────────────────────────────────────────────────
# Lấy từ Zalo for Developers → Official Account → Settings → Access Token
ZALO_BOT_TOKEN=your_zalo_oa_access_token

# Base URL của Zalo Open API (không đổi trừ khi Zalo release API mới)
ZALO_BASE_URL=https://openapi.zalo.me

# ── Upstream services ─────────────────────────────────────────────────────────
# URL của models-service (không có trailing slash)
MODEL_SERVICE_URL=http://localhost:8000

# ── Webhook ───────────────────────────────────────────────────────────────────
# Secret dùng để verify chữ ký X-ZEvent-Signature từ Zalo (8–256 ký tự)
# Để trống nếu không dùng signature verification (không khuyến nghị production)
WEBHOOK_SECRET_TOKEN=your_secret_token_here

# Public URL mà Zalo Platform sẽ POST event tới (bắt buộc HTTPS)
# Dev: dùng ngrok → https://<random>.ngrok.io
# Prod: domain thật có TLS certificate
WEBHOOK_BASE_URL=https://your-domain.ngrok.io

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
BOT_LOG_PATH=logs/zalo.log

# Debug only: log full question/answer content in zalo-service logs.
# 0 = off (default), 1 = on
TRACE_CHAT_CONTENT=0
