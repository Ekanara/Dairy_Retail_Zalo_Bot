# ─────────────────────────────────────────────────────────────
# models-service — environment variables
# Copy to .env and fill in your values before starting.
# NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────

# ── LLM backend ──────────────────────────────────────────────
# Any OpenAI-compatible endpoint (OpenAI, vLLM, LM Studio …)
MODEL_NAME=gpt-4.1-mini
API_KEY=your_openai_api_key_here
BASE_URL=https://api.openai.com/v1

# ── Upstream services ─────────────────────────────────────────
PROMPT_SERVICE_URL=http://localhost:8001
MCP_SERVICE_URL=http://localhost:8004
CHAT_SERVICE_URL=http://localhost:8007

# Enable/disable features
MCP_ENABLED=true
CHAT_HISTORY_ENABLED=true

# ── Logging ───────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── HTTP timeouts (seconds) ───────────────────────────────────
PROMPT_SERVICE_TIMEOUT=10.0
CHAT_SERVICE_TIMEOUT=5.0
LLM_TIMEOUT=60.0
