# ---------------------------------------------------------------
# mcp-service — Environment Variables
# Copy file này thành .env và điền giá trị thực
# KHÔNG commit file .env vào git
# ---------------------------------------------------------------

# PostgreSQL — DB dùng chung với data-service và order-service
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/magic_sale

# Embedding model — Gemma 3 0.3B chạy qua Ollama (OpenAI-compatible)
EMBEDDING_MODEL_NAME=gemma3:0.3b
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama

# Email SMTP — Gmail App Password (bật 2FA → tạo App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=Magic Sale <your_email@gmail.com>

# Service URLs nội bộ
PROMPT_SERVICE_URL=http://localhost:8001
ORDER_SERVICE_URL=http://localhost:8003

# Logging
LOG_LEVEL=INFO

# MCP transport: mặc định "http"; có thể đổi sang "stdio" nếu cần
# MCP_TRANSPORT=http
# MCP_HOST=0.0.0.0
# MCP_PORT=8004
