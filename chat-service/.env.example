# ============================================================
# chat-service/.env.example — Configuration template
# Copy to .env and adjust for your environment.
# DO NOT commit .env with real credentials.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/magic_sale

# ── Redis ────────────────────────────────────────────────────
# Redis connection string
REDIS_URL=redis://localhost:6379/0

# ── Service configuration ────────────────────────────────────
LOG_LEVEL=INFO
SERVICE_PORT=8007

# ── Cache settings ───────────────────────────────────────────
# Redis cache TTL in seconds (default 86400 = 24 hours)
CACHE_TTL=86400

# Default number of messages to return (default 100)
DEFAULT_TOP_K=100
