# ============================================================
# infrastructure/.env.example — Shared infrastructure variables
# Copy to .env and adjust for your environment.
# DO NOT commit .env with real credentials.
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=magic_sale
POSTGRES_PORT=5433

# ── Redis ────────────────────────────────────────────────────
REDIS_PORT=6379

# ── Service ports (for local dev reference) ──────────────────
ZALO_SERVICE_PORT=8080
MODELS_SERVICE_PORT=8000
PROMPT_SERVICE_PORT=8001
DATA_SERVICE_PORT=8002
ORDER_SERVICE_PORT=8003
MCP_SERVICE_PORT=8004
